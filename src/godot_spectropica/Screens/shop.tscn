[node name="Spacer" type="Control" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Purse" type="PanelContainer" parent="Header"]
layout_mode = 2
theme_override_styles/panel = SubResource("Purse")

[node name="Row" type="HBoxContainer" parent="Header/Purse"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Coin" type="TextureRect" parent="Header/Purse/Row"]
texture_filter = 1
