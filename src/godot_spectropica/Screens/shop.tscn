content_margin_right = 16.0

[sub_resource type="StyleBoxFlat" id="Purse"]
bg_color = Color(1, 0.94, 0.73, 1)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_left = 18
corner_radius_bottom_right = 18
content_margin_left = 14.0
content_margin_right = 14.0

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.72, 0.85, 0.77, 1)

[node name="ShopCard" type="PanelContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 96.0
offset_right = -24.0
offset_bottom = -24.0
theme_override_styles/panel = SubResource("Card")

[node name="Center" type="CenterContainer" parent="ShopCard"]
layout_mode = 2

[node name="Message" type="VBoxContainer" parent="ShopCard/Center"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="ShopCard/Center/Message"]
layout_mode = 2
theme_override_colors/font_color = Color(0.16, 0.29, 0.23, 1)
theme_override_font_sizes/font_size = 42
text = "Cosmetics Shop"
