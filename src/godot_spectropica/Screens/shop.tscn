[node name="Empty" type="Label" parent="ShopCard/Center/Message"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.36, 0.29, 1)
theme_override_font_sizes/font_size = 20
text = "No items yet"
horizontal_alignment = 1

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = 76.0

[node name="Back" type="Button" parent="Header"]
custom_minimum_size = Vector2(108, 52)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.16, 0.29, 0.23, 1)
theme_override_colors/font_hover_color = Color(0.16, 0.29, 0.23, 1)
theme_override_colors/font_pressed_color = Color(0.16, 0.29, 0.23, 1)
theme_override_colors/font_focus_color = Color(0.16, 0.29, 0.23, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("Back")
theme_override_styles/hover = SubResource("BackHover")
theme_override_styles/pressed = SubResource("Purse")
