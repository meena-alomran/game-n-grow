[gd_scene format=3 uid="uid://irsm0qp4wn38"]

[sub_resource type="GDScript" id="GDScript_n2snw"]
script/source = "extends CanvasLayer

@onready var point_label: Label = $MarginContainer/PointsLabel


func _ready() -> void:
	_update_label(Wallet.coins)
	Wallet.coins_changed.connect(_update_label)


func _update_label(amount: int) -> void:
	point_label.text = \"Points: %d\" % amount
	

# TEMPORARY: press C to add a coin. Delete once the box gives coins.
func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and event.keycode == KEY_C:
		Wallet.add_coins(1)
"

[node name="Hud" type="CanvasLayer" unique_id=1591543845]
script = SubResource("GDScript_n2snw")

